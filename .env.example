# SentinelP2P local application configuration.
# Copy to .env only when .env does not already exist; keep real secrets local.

# Data paths. Relative paths resolve from the current working directory.
SENTINEL_DATA_DIR=./data
SENTINEL_INVESTIGATION_DB=./data/investigations.sqlite3

# Local frontend API default. VITE_API_BASE_URL is a build-time value; because
# Vite reads frontend/.env by default, setup must pass this root value into the
# frontend build environment explicitly.
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:4173,http://localhost:4173
VITE_API_BASE_URL=/api

# Optional local-only Sentinel AI provider. Leave OLLAMA_MODEL blank to disable
# answer generation. Select and install a local model separately.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=
OLLAMA_TIMEOUT=120

# Optional external business research for vendor investigations. Keep the key
# blank unless you explicitly configure Tavily; it is not used by Sentinel AI.
TAVILY_API_KEY=
TAVILY_API_URL=https://api.tavily.com/search

# Optional Neo4j tools. Do not put production credentials in this example.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
